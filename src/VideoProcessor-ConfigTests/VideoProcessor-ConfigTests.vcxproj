    <ClCompile Include="..\VideoProcessor-Lib\ConfigFile.cpp" />
    <ClCompile Include="..\VideoProcessor-Lib\DisplayRefreshRatePolicy.cpp"><PrecompiledHeader>NotUsing</PrecompiledHeader></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="ToneChartIntegrationTests.inc" />
    <ClInclude Include="..\VideoProcessor-Config\ConfigEditorWindow.h" />
    <ClInclude Include="..\VideoProcessor-Config\VpTheme.h" />
    <ClInclude Include="..\VideoProcessor-ConfigCore\ConfigEditorCore.h" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\VP-V\build\VideoProcessor-ConfigTests.items.props" Condition="Exists('$(MSBuildThisFileDirectory)..\VP-V\build\VideoProcessor-ConfigTests.items.props')" />
