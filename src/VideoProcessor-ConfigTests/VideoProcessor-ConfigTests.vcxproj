  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C8CA4B71-E41A-45D2-88FC-E96724DF68E4}</ProjectGuid>
    <RootNamespace>VideoProcessorConfigTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.19041.0</WindowsTargetPlatformVersion>
    <TargetName>VideoProcessorConfigTests</TargetName>
    <QtVersion>6.8.3</QtVersion>
    <QtArchitecture>msvc2022_64</QtArchitecture>
    <QtRoot Condition="'$(VP_QT_ROOT)' != ''">$(VP_QT_ROOT)</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == '' and Exists('$(LOCALAPPDATA)\VideoProcessor\dependencies\Qt\$(QtVersion)\$(QtArchitecture)\bin\qmake.exe')">$(LOCALAPPDATA)\VideoProcessor\dependencies\Qt\$(QtVersion)\$(QtArchitecture)</QtRoot>
    <QtRoot Condition="'$(QtRoot)' == ''">$(ProjectDir)..\..\.dependencies\Qt\$(QtVersion)\$(QtArchitecture)</QtRoot>
  </PropertyGroup>
