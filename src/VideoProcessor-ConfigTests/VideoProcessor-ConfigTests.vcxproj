    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)x64\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)x64\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- Bill's DisplayMonitorInventory.h (VideoProcessor-Lib) includes <atlbase.h>. Where the active toolset
       ships no ATL, fall back to the side-by-side 14.29 toolset's ATL when it is installed; any machine whose
       active toolset has ATL (or lacks 14.29) is unaffected. Proper fix: that header uses Microsoft::WRL::ComPtr. -->
  <PropertyGroup Condition="!Exists('$(VCToolsInstallDir)atlmfc\include\atlbase.h') And Exists('$(VCInstallDir)Tools\MSVC\14.29.30133\atlmfc\include\atlbase.h')">
    <VpAtlFallbackInclude>$(VCInstallDir)Tools\MSVC\14.29.30133\atlmfc\include;</VpAtlFallbackInclude>
    <VpAtlFallbackLib>$(VCInstallDir)Tools\MSVC\14.29.30133\atlmfc\lib\x64;</VpAtlFallbackLib>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /bigobj %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;VP_CONFIGFILE_STANDALONE;QT_WIDGETS_LIB;QT_GUI_LIB;QT_CORE_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(VpAtlFallbackInclude)..\VideoProcessor-Config\standalone;$(QtRoot)\include;$(QtRoot)\include\QtWidgets;$(QtRoot)\include\QtGui;$(QtRoot)\include\QtCore;..\VideoProcessor-Config;..\VideoProcessor-Lib;..\VideoProcessor-ConfigCore;..\..\3rdparty\libplacebo-beta\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(VpAtlFallbackLib)$(QtRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Qt6Widgets.lib;Qt6Gui.lib;Qt6Core.lib;Ws2_32.lib;shell32.lib;user32.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>"$(QtRoot)\bin\windeployqt.exe" --release --no-translations --no-system-d3d-compiler "$(TargetPath)"
copy /Y "$(QtRoot)\plugins\platforms\qoffscreen.dll" "$(TargetDir)platforms\qoffscreen.dll"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="ConfigEditorWindowTests.cpp" />
    <ClCompile Include="..\VideoProcessor-ChartCore\ToneCurveModel.cpp" />
    <ClCompile Include="..\VideoProcessor-ChartCore\ToneCurveRuntime.cpp" />
