  VP-V items for VideoProcessor-BetaTestsHost (imported by the VPV-HOOK line of that project). R1-CAMACC: the camera units
  the camera accuracy report (BetaGpuTests.cpp, VP_TEST_CAMERA_ACCURACY) drives directly: the fitter, the measurement plan
  and BuildGuide. WAIVER-MV-04: the REAL MotionAhead producer (MotionAheadProducer.cpp) the report drives for its optical-flow pairs. Test code only; no runtime project lists these through this file.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\beta_gpu\BetaTestHost.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelGeometry.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelTemporal.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\DynamicTexture.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\StaticHypothesis.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelObjects.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelFit.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\PhotometricRefine.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelSearchHints.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\GlobalModelMeasurement.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\global_model\link\GuidanceScheduler.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\motion\estimation\MotionAheadProducer.cpp"/>
    <!-- AnalysisLumaSource.cpp includes the Lib pch (MFC, DirectShow): not compilable here; the test stub implements what the producer calls. -->
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\beta_gpu\AnalysisLumaSourceTestStub.cpp"/>
    <!-- refs/105 phase 0 (PT-A): the producer throughput bench (VP_PT_BENCH=1; drives the real producer only). -->
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\beta_gpu\ProducerThroughputBench.cpp"/>
    <!-- Slice 16 P3 (refs/105 s3.7): serial vs pipelined 600-frame P2 hash identity (hints on and off). -->
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\beta_gpu\ProducerPipelineIdentityGpuTests.cpp"/>
    <!-- C5-BETALINK: BBP-B B3. DejudderWarp.cpp calls VpFrameAnalysis::P1Gpu::BuildPyramidInto (the one code copy of the pyramid law),
         defined in P1GpuFill.cpp, as the VPRenderer / VPRendererBeta items list it (no pch there either). Its real dependencies follow. -->
    <ClCompile Include="$(MSBuildThisFileDirectory)..\modules\input\source_analysis\lane\P1GpuFill.cpp"/>
    <!-- P1GpuFill.cpp's module registration and source-luma note go through the hub (Instance / AddModule / OriginalPathway). -->
    <ClCompile Include="$(MSBuildThisFileDirectory)..\core\hub\ExtensionHub.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\beta_gpu\BetaParametersVpvHooks.cpp"/>
    <ClCompile Include="$(MSBuildThisFileDirectory)..\tests\support\HardwarePrerequisites.cpp"/>
  </ItemGroup>
</Project>
