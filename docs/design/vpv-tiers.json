        "input.capture",
        "input.signal",
        "input.queue_timing",
        "input.source_analysis"
      ],
      "tiers": [],
      "untiered_reason": "Always on: capture and timing have no quality steps, only paths (the toggles below).",
      "presets": {},
      "toggles": [
        {
          "key": "capture_path",
          "label": "Capture unpack on the GPU",
          "values": [
            "gpu",
            "standard"
          ],
          "slot": "input.capture"
        },
        {
          "key": "capture_upload",
          "label": "Upload frames as they arrive",
          "values": [
            "auto",
            "render",
            "early"
          ],
          "slot": "input.capture"
        },
        {
          "key": "native_rgb_ingest",
          "label": "Native 10/12-bit RGB capture",
          "values": [
            "on",
            "off"
          ],
          "slot": "input.capture"
        },
        {
          "key": "dv_tunnel_gpu_unpack",
          "label": "Dolby Vision tunnel: GPU unpack",
          "values": [
            "on",
            "off"
          ],
          "slot": "input.signal"
        }
      ],
      "planned": [
        {
