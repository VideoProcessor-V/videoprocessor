    },
    {
      "id": "motion",
      "name": "Motion",
      "summary": "Measures motion once on the untouched picture and feeds the de-judder, hiccup repair and dither.",
      "slots": [
        "motion.estimation",
        "motion.vector_delivery",
        "motion.consumers"
      ],
      "tiers": [
        "Classic",
        "Low",
        "Mid",
        "Upper"
      ],
      "presets": {
        "Classic": {
          "description": "No motion processing: frames shown as delivered (VP's de-judder off, no motion search).",
          "cost": "none",
          "set": {
            "dejudder_strength": "0",
            "dejudder_strength_even": "0",
            "optical_flow": "off",
            "motion_ahead_frames": "0"
          }
        },
        "Low": {
          "description": "De-judder with VP's own motion search only (no NVIDIA engine, nothing computed ahead): cheapest working motion.",
          "cost": "low",
          "set": {
            "optical_flow": "off",
            "motion_ahead_frames": "0",
            "dejudder_est_split": "off"
          },
          "on_enter": [
            {
              "key": "dejudder_strength",
              "from": "0",
              "to": "0.25"
            }
          ]
        },
        "Mid": {
          "description": "NVIDIA optical-flow engine plus VP's matcher, vectors computed 4 frames ahead (the default motion engine).",
          "cost": "medium",
          "set": {
            "optical_flow": "on",
            "motion_ahead_frames": "4",
            "dejudder_est_split": "off"
          },
          "on_enter": [
            {
              "key": "dejudder_strength",
              "from": "0",
              "to": "0.25"
            }
          ]
        },
        "Upper": {
          "description": "As Mid, and poorly matched blocks are searched again as quarter blocks (small objects on moving backgrounds get their own motion).",
          "cost": "medium-high",
          "set": {
            "optical_flow": "on",
            "motion_ahead_frames": "4",
            "dejudder_est_split": "on"
          },
          "on_enter": [
            {
              "key": "dejudder_strength",
              "from": "0",
              "to": "0.25"
            }
          ]
        }
      },
      "taste": [
        "dejudder_strength",
        "dejudder_strength_even"
      ],
      "toggles": [
        {
          "key": "interpolation_fill_gaps",
          "label": "Fill dropped frames (hiccup repair)",
          "values": [
            "on",
            "off"
          ],
          "slot": "motion.consumers"
        },
        {
          "key": "interpolation",
          "label": "Frame interpolation (50/60p)",
          "values": [
            "off",
            "auto",
            "always"
