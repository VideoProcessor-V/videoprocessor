diff --git a/src/VideoProcessor-Lib/vprenderer/LibplaceboVideoRenderer.cpp b/src/VideoProcessor-Lib/vprenderer/LibplaceboVideoRenderer.cpp
@@ (renderer init, after the adaptive downscale module is set up) @@
+		// VP-V D: inside the hybrid's POST_KERNEL, on the hook's gpu/dispatch.
+		adaptiveDownscale.postBlend = [this](const pl_hook_params* p, pl_tex blended, pl_tex source, const pl_rect2df& rect) -> pl_tex
+		{
+			using namespace VpNets;
+			const NetDeviceContext dev = PlNetRunner::DeviceFromHook(p);
+			if (dLoadPending)
+			{
+				dRunner.SetTiming(&slotTiming, PipelineSlots::Id::ScalingOutput);
+				dLoaded = dSlot.Load(dev, dPkg, NetContextFor(dPkg));   // checks upstream nets (A) + motion mode
+				dLoadPending = false;
+			}
+			if (!dLoaded)
+				return blended;
+			pl_hook_params hp = *p;
+			hp.tex = blended;                                     // D refines the BLEND output
+			NetTexture src;
+			src.handle = const_cast<pl_tex_t*>(source);
+			src.width = source->params.w; src.height = source->params.h; src.components = 4;
+			src.rect[0] = rect.x0; src.rect[1] = rect.y0; src.rect[2] = rect.x1; src.rect[3] = rect.y1;   // fractional -> refused, visible
+			PlNetRunner::PostKernelOptions o;                     // BT.709 luma of the hook's (linear) RGB: R8 caveat
+			NetTexture out;
+			std::string err;
+			// Per frame: the upstream nets now (A may have bypassed this frame) and the motion mode.
+			const std::string upNow = UpstreamNetsKey({ repairSlot.State("repair.encoding") });
+			if (upNow != NetContextFor(dPkg).upstreamNets) { dLoadPending = true; return blended; }   // reload on the next frame
+			if (!dRunner.RunInPostKernelHook(&hp, src, out, &err, o))
+			{
+				netBypass.Bypass(dPkg.name, err);
+				return blended;
+			}
+			netBypass.Clear(dPkg.name);
+			return static_cast<pl_tex>(out.handle);
+		};
